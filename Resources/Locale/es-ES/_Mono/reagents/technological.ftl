reagent-name-superconductant = superconductante
reagent-desc-superconductant = A pesar de su nombre, en realidad no es un superconductor, sino simplemente óxido de cobre; aun así, es un componente útil en la electrónica de alta velocidad.

reagent-name-lithiumhydroxide = hidróxido de litio
