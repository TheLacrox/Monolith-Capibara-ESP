# Capibara ESP — fork-owned keys for ambientSpaceBiome prototypes.
# Upstream defines these names/descriptions as raw strings in
# Resources/Prototypes/_Crescent/Biomes/space_biomes.yml with no Loc hook;
# SpaceTextDisplaySystem (Capibara divergence) looks up space-biome-<ID>-name/-desc
# and falls back to the raw YAML string when a key is missing.

space-biome-BiomeDefault-name = Espacio inexplorado

space-biome-BiomeExpedition-name = Expedición
space-biome-BiomeExpedition-desc = Tierra inexplorada.

space-biome-BiomeFTL-name = Hiperespacio
space-biome-BiomeFTL-desc = Sobre el caballo pálido, con el Infierno a tu espalda.

space-biome-BiomeFarReachesIV-name = Nube Exterior IV
space-biome-BiomeFarReachesIV-desc = ¿De verdad merece la pena?

space-biome-BiomeFarReachesIII-name = Nube Exterior III
space-biome-BiomeFarReachesIII-desc = Aquí han aprendido a caminar cosas que deberían arrastrarse.

space-biome-BiomeFarReachesII-name = Nube Exterior II
space-biome-BiomeFarReachesII-desc = Ya no queda nada tan lejos. O eso acabarías deseando.

space-biome-BiomeFarReachesI-name = Nube Exterior I
space-biome-BiomeFarReachesI-desc = Sientes que los asteroides se mueven incluso cuando tú no lo haces. O que te observan. O ambas cosas.

space-biome-BiomeOuterRing-name = Intersticio de la Nube
space-biome-BiomeOuterRing-desc = Más allá del rubicón interior. El parloteo de la radio se apaga y las estrellas se atenúan.

space-biome-BiomeMiddleRing-name = Rubicón Interior
space-biome-BiomeMiddleRing-desc = Una corona de riqueza, oportunidades y, posiblemente, peligro.

space-biome-BiomeInnerRing-name = Región Interior de Colossus
space-biome-BiomeInnerRing-desc = Espacio civilizado. Las constelaciones que se ven desde aquí están grabadas en tu memoria.
space-biome-BiomeClusterA-name = INSO-357k
space-biome-BiomeClusterA-desc = Un cementerio estelar de cascarones y rocas a la deriva.
space-biome-BiomeWilds-name = Cúmulo de Asteroides LINEAR-21
space-biome-BiomeWilds-desc = Un océano de riquezas de regolito. De vez en cuando, en los sensores tiemblan formas.